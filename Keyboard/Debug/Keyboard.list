0800051c <HID_IsIdle>:
void delay_us(uint16_t us) {
	__HAL_TIM_SET_COUNTER(&htim2, 0);  // reset counter back to 0
	while (__HAL_TIM_GET_COUNTER(&htim2) < us);  // wait for the counter to reach desired time
}

